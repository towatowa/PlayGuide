<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PlayGuide.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PlayGuide"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="40,30,40,40" Spacing="24">

            <!--  标题  -->
            <TextBlock
                local:Loc.Text="Settings"
                FontSize="28"
                FontWeight="SemiBold" />

            <!--  ================= 常规 =================  -->
            <TextBlock
                Margin="0,10,0,0"
                local:Loc.Text="Normal"
                FontSize="16"
                Opacity="0.7" />

            <!--  语言  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        Margin="8"
                        FontSize="18"
                        Glyph="&#xF2B7;" />

                    <!--  Global  -->
                    <StackPanel Grid.Column="1" Margin="0,8,0,8">
                        <TextBlock local:Loc.Text="Language" FontSize="16" />
                    </StackPanel>

                    <ComboBox
                        x:Name="LanguageComboBox"
                        Grid.Column="2"
                        Width="180"
                        HorizontalAlignment="Right"
                        ItemsSource="{x:Bind ViewModel.LanguageList}"
                        SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:OptionItem">
                                <TextBlock Text="{x:Bind Text}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!--  主题  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        Margin="8"
                        FontSize="18"
                        Glyph="&#xE793;" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,8,0,8"
                        local:Loc.Text="Theme"
                        FontSize="16" />

                    <ComboBox
                        x:Name="ThemeBox"
                        Grid.Column="2"
                        Width="180"
                        ItemsSource="{x:Bind ViewModel.ThemeList}"
                        SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:OptionItem">
                                <TextBlock Text="{x:Bind Text}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!--  托盘  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        Margin="8"
                        FontSize="18"
                        Glyph="&#xE9F5;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock local:Loc.Text="SystemTrayRun" />
                        <TextBlock
                            local:Loc.Text="SystemTrayRun_Description"
                            FontSize="12"
                            Opacity="0.6" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="TraySwitch"
                        Grid.Column="2"
                        IsOn="{x:Bind ViewModel.SystemTrayExecute, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!--  ================= 启动 =================  -->
            <TextBlock
                Margin="0,10,0,0"
                local:Loc.Text="StartUp"
                FontSize="16"
                Opacity="0.7" />

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        Margin="8"
                        FontSize="18"
                        Glyph="&#xE768;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock local:Loc.Text="RunAtStartUp" />
                        <TextBlock
                            local:Loc.Text="RunAtStartUp_Description"
                            FontSize="12"
                            Opacity="0.6" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="AutoStartSwitch"
                        Grid.Column="2"
                        IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel Spacing="6">

                    <!--  原设置项  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Margin="8"
                            FontSize="18"
                            Glyph="&#xE72E;" />

                        <StackPanel Grid.Column="1">

                            <TextBlock local:Loc.Text="RunAsAdmin" />

                            <TextBlock
                                local:Loc.Text="RunAsAdmin_Description"
                                FontSize="12"
                                Opacity="0.6" />

                        </StackPanel>

                        <ToggleSwitch
                            x:Name="AdminSwitch"
                            Grid.Column="2"
                            IsOn="{x:Bind ViewModel.RunningAsAdmin, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock
                        Margin="40,0,0,0"
                        local:Loc.Text="RunAsAdminNeedRestart"
                        FontSize="12"
                        Visibility="{x:Bind ViewModel.HasRestartReason('RunAsAdmin'), Mode=OneWay}">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="Red" />
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  ================= 性能 =================  -->
            <TextBlock
                Margin="0,10,0,0"
                FontSize="16"
                Opacity="0.7"
                Text="性能" />

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <FontIcon
                                Margin="8"
                                FontSize="18"
                                Glyph="&#xE950;" />
                            <StackPanel>
                                <TextBlock local:Loc.Text="IntelCpuUseECore" />
                                <TextBlock
                                    local:Loc.Text="IntelCpuUseECore_Description"
                                    FontSize="12"
                                    Opacity="0.6" />
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ECoreSwitch"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            IsEnabled="{x:Bind ViewModel.IsIntelCpu(), Mode=OneTime}"
                            IsOn="{x:Bind ViewModel.IntelCpuUseECore, Mode=TwoWay}" />
                    </Grid>
                    <!--
                    <TextBlock local:Loc.Text="RunAsAdminNeedRestart"
                               FontSize="12"
                               Margin="40,0,0,0"
                               Visibility="{x:Bind ViewModel.HasRestartReason('IntelCpuUseECore'), Mode=OneWay}">
                               <TextBlock.Foreground>
                                   <SolidColorBrush Color="Red"/>
                               </TextBlock.Foreground>
                    </TextBlock>-->
                </StackPanel>
            </Border>

            <!--  ================= 输入 =================  -->
            <TextBlock
                Margin="0,10,0,0"
                FontSize="16"
                Opacity="0.7"
                Text="输入" />

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        Margin="8"
                        FontSize="18"
                        Glyph="&#xE765;" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,8,0,8"
                        Text="按键捕获方式" />

                    <ComboBox
                        x:Name="KeyCaptureBox"
                        Grid.Column="2"
                        Width="200"
                        HorizontalAlignment="Right">
                        <ComboBoxItem Content="Hook (全局钩子)" />
                        <ComboBoxItem Content="Raw Input（推荐）" />
                    </ComboBox>
                </Grid>
            </Border>
            <!--  ================= 输入 =================  -->
            <TextBlock
                Margin="0,10,0,0"
                FontSize="16"
                Opacity="0.7"
                Text="快捷键设置" />
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <!--  全局开关  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xE765;" />
                            <StackPanel>
                                <TextBlock local:Loc.Text="EnableHotkeys_Name" />
                                <TextBlock
                                    local:Loc.Text="EnableHotkeys_Description"
                                    FontSize="12"
                                    Opacity="0.6" />
                            </StackPanel>
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="1"
                            Margin="0,0,-75,0"
                            HorizontalAlignment="Right"
                            IsEnabled="{x:Bind ViewModel.HotkeysEnabled, Mode=TwoWay}" />
                    </Grid>

                    <!--  分割线  -->
                    <Rectangle
                        Height="1"
                        Margin="0,8"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <ListView x:Name="HotkeyList" IsItemClickEnabled="False">

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:HotkeyItemViewModel">

                                <Grid Padding="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="400" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  左侧  -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon VerticalAlignment="Center" Glyph="{x:Bind IconGlyph}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" />
                                            <TextBlock
                                                FontSize="12"
                                                Opacity="0.6"
                                                Text="{x:Bind Description}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  当前快捷键  -->

                                    <!--  2. 中间快捷键拆分显示 (重点修改)  -->
                                    <ItemsControl
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ItemsSource="{x:Bind SplitKeys, Mode=OneWay}">
                                        <!--  设置水平排列并带间距  -->
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <!--  每一个按键的样式  -->
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border
                                                    MinWidth="28"
                                                    Padding="8,2"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  修改按钮  -->
                                    <Button Grid.Column="2"
                                        Margin="0,10,0,10"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Content="修改">
                                        <Button.Flyout>
                                            <Flyout Opening="HotkeyFlyout_Opening">
                                                <StackPanel Width="320" Spacing="12"
                                                            KeyDown="HotkeyCaptureBorder_KeyDown">

                                                    <TextBlock FontWeight="SemiBold" Text="按下新的快捷键" />

                                                    <!--  捕获区域  -->
                                                    <Border
                                                        MinHeight="52"
                                                        Padding="12"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        IsTabStop="True"
                                                        >

                                                        <!--  和列表完全一致  -->
                                                        <ItemsControl ItemsSource="{x:Bind RecordingKeys, Mode=OneWay}">

                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>

                                                            <ItemsControl.ItemTemplate>

                                                                <DataTemplate x:DataType="x:String">

                                                                    <StackPanel Orientation="Horizontal" Spacing="4">

                                                                        <Border
                                                                            MinWidth="28"
                                                                            Padding="8,2"
                                                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4">

                                                                            <TextBlock
                                                                                HorizontalAlignment="Center"
                                                                                FontSize="12"
                                                                                FontWeight="SemiBold"
                                                                                Text="{x:Bind}" />
                                                                        </Border>

                                                                    </StackPanel>

                                                                </DataTemplate>

                                                            </ItemsControl.ItemTemplate>

                                                        </ItemsControl>

                                                    </Border>
                                                    <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="CancelCaptureButton"
                                                        FontSize="12"
                                                        Opacity="0.6"
                                                        Content="取消"
                                                        Click="CancelCapture_Click"/>
                                                    <Button x:Name="SaveCaptureButton"
                                                            FontSize="12"
                                                            Opacity="0.6"
                                                            Content="保存"
                                                            Click="SaveCapture_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>