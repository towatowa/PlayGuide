<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PlayGuide.ControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PlayGuide"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="PlayGuide"
    mc:Ignorable="d">

    <!--  设置系统背景为 Mica  -->
    <Window.SystemBackdrop>
        <media:DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Margin="0"
        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
        PointerEntered="Grid_PointerEntered"
        PointerExited="Grid_PointerExited"
        PointerMoved="Grid_PointerMoved"
        PointerPressed="Grid_PointerPressed"
        PointerReleased="Grid_PointerReleased">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  🔝 Tab  -->
        <TabView
            x:Name="urlTabView"
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            IsAddTabButtonVisible="True"
            TabWidthMode="Equal" />
        <!--  🌐 地址栏  -->
        <Border
            Grid.Row="1"
            Height="38"
            Margin="0,8,0,0"
            Padding="10,0"
            Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
            CornerRadius="8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />

                    <!--  标签  -->
                </Grid.ColumnDefinitions>

                <!--  图标  -->
                <SymbolIcon
                    x:Name="SiteIcon"
                    Margin="8,8,8,8"
                    VerticalAlignment="Center"
                    Symbol="Globe" />

                <!--  URL 输入  -->
                <AutoSuggestBox
                    x:Name="UrlBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    PlaceholderText="Search Google or type a URL"
                    QueryIcon="Link" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">

            <!--  左侧 About  -->
            <Button
                Grid.Column="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="AboutButton_Clicked">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE946;" />
                    <TextBlock x:Name="About" />
                </StackPanel>
            </Button>

            <!--  中间 Hotkey List  -->
            <ListView
                x:Name="HotkeyLabels"
                Grid.Column="1"
                Margin="0,0,0,0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                SelectionMode="None"
                SizeChanged="HotkeyLabels_SizeChanged">
                <!--  关键点 1：监听尺寸变化  -->

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--  使用 StackPanel 确保绝对不会重叠，它们会一个接一个水平排开  -->
                        <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:HotkeyItemViewModel">
                        <!--
                            关键点 2：这里的 Width 不要设为 Stretch（StackPanel下无效），
                            而是留空，我们会通过控制外部容器或动态分配来平分
                        -->
                        <Grid x:Name="ItemRoot" Background="Transparent">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <FontIcon Glyph="{x:Bind IconGlyph}" />
                                <TextBlock Text="{x:Bind FormattedKey()}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  右侧 Settings  -->
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="SettingsButton_Clicked">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE713;" />
                    <TextBlock x:Name="Setting" />
                </StackPanel>
            </Button>

        </Grid>
    </Grid>

</Window>