<Page
    x:Class="PlayGuide.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="18">

            <!-- App Icon -->
            <Image
                Width="72"
                Height="72"
                Source="/Assets/AppIcon.png"
                HorizontalAlignment="Left"/>

            <!-- App Name -->
            <TextBlock
                Text="PlayGuide"
                FontSize="28"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="A modern WebView2-based desktop browser"
                Opacity="0.7"/>

            <Rectangle Height="1" Opacity="0.15" Margin="0,10,0,10"/>

            <!-- Info -->
            <StackPanel Spacing="10">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="版本" Width="160"/>
                    <TextBlock Text="1.0.0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="许可证" Width="160"/>
                    <TextBlock Text="MIT"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="GitHub" Width="160"/>
                    <HyperlinkButton Content="打开仓库"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="WebView2 Runtime" Width="160"/>
                    <TextBlock x:Name="WebView2VersionText"/>
                </StackPanel>

            </StackPanel>

            <Rectangle Height="1" Opacity="0.15" Margin="0,10,0,10"/>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="12">

                <Button Content="检查更新" Click="OnCheckUpdate"/>
                <Button Content="反馈问题"/>
                <Button Content="复制版本信息"/>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>